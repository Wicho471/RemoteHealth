<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ─────────────────────────────
         DATOS BÁSICOS DEL MÓDULO
         ───────────────────────────── -->
    <modelVersion>4.0.0</modelVersion>
	
    <!-- *Hereda* de RemoteHealth                     -->
    <parent>
        <groupId>org.axolotlj</groupId>
        <artifactId>RemoteHealth</artifactId>
        <version>0.3.5</version>
    </parent>

    <!-- Mantengo tu artefactId “celular” para respetar la plantilla -->
    <artifactId>mobile</artifactId>
    <packaging>jar</packaging>
    <name>remotehealth-mobile</name>

    <!-- ─────────────────────────────
         PROPIEDADES
         ───────────────────────────── -->
    <properties>
        <!-- Las heredadas del padre ya incluyen maven.compiler.release=17 -->
        <glisten.version>6.2.3</glisten.version>
        <attach.version>4.0.23</attach.version>
        <mainClassName>org.axolotlj.remotehealth.mobile.MobileApp</mainClassName>
		<gluonfxTarget>host</gluonfxTarget>
		
		<!-- for Android -->
        <version.code>500</version.code>
        <version.name>0.3.5</version.name>
        <android.keystore.path/>
        <android.keystore.password/>
        <android.keyalias/>
        <android.keyalias.password/>
        
        <!-- for iOS -->
        <iosSignIdentity/>
        <iosProvisioningProfile/>
        <bundle.version>500</bundle.version>
        <bundle.short.version>4.8.1</bundle.short.version>
    </properties>

    <!-- ─────────────────────────────
         DEPENDENCIAS
         ───────────────────────────── -->
    <dependencies>
        <!-- núcleo compartido -->
        <dependency>
            <groupId>org.axolotlj</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JavaFX y Gluon Charm -->
        <dependency>
            <groupId>com.gluonhq</groupId>
            <artifactId>charm-glisten</artifactId>
            <version>${glisten.version}</version>
			<exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Gluon Attach (servicios de dispositivo) -->
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>display</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>lifecycle</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>statusbar</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>storage</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>util</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
		    <groupId>com.gluonhq.attach</groupId>
		    <artifactId>barcode-scan</artifactId>
		    <version>${attach.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>com.gluonhq.attach</groupId>
		    <artifactId>pictures</artifactId>
		    <version>${attach.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>com.gluonhq.attach</groupId>
		    <artifactId>orientation</artifactId>
		    <version>${attach.version}</version>
		</dependency>
		
		  <dependency>
		    <groupId>com.gluonhq.attach</groupId>
		    <artifactId>device</artifactId>
		    <version>${attach.version}</version>
		  </dependency>
		  <dependency>
		    <groupId>com.gluonhq.attach</groupId>
		    <artifactId>push-notifications</artifactId>
		    <version>${attach.version}</version>
		  </dependency>
		  <dependency>
		    <groupId>com.gluonhq.attach</groupId>
		    <artifactId>runtime-args</artifactId>
		    <version>${attach.version}</version>
		  </dependency>
		  
</dependencies>



    <!-- ─────────────────────────────
         REPOSITORIOS  (ya heredados del padre)
         ───────────────────────────── -->

    <!-- ─────────────────────────────
         PLUGINS DE BUILD
         ───────────────────────────── -->
    <build>
        <plugins>
            <!-- JavaFX RUN (útil para simular) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClassName}</mainClass>
                </configuration>
            </plugin>

            <!-- GluonFX: build y native-image -->
            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>${gluonfx.plugin.version}</version>
                <configuration>
                	<verbose>true</verbose>
                	
                	<target>android</target>
                	
			        <reflectionList>
			            <list>org.axolotlj.remotehealth.mobile.controller.HomeController</list>
			            <list>org.axolotlj.remotehealth.mobile.controller.MonitorContoller</list>
			            <list>org.axolotlj.remotehealth.mobile.controller.QrScannerController</list>
			            <list>org.axolotlj.remotehealth.mobile.MobileConfigurator</list>	
			        </reflectionList>
                
                    <attachList>
                        <list>display</list>
                        <list>lifecycle</list>
                        <list>statusbar</list>
                        <list>storage</list>
                        <list>barcode-scan</list>
                        <list>camera</list>
                        <list>pictures</list>
                        <list>orientation</list>
                        <list>device</list>
						<list>push-notifications</list>
						<list>runtime-args</list>
                    </attachList>
                    
                    
					<mainClass>${mainClassName}</mainClass>
                    <appIdentifier>org.axolotlj.remotehealth.mobile</appIdentifier>


					
					
					<releaseConfiguration>
						
						<!-- for iOS -->
					    
					    <!-- for Android -->
					    <appLabel>RemoteHealth</appLabel>
					    
					    <versionCode>${version.code}</versionCode>
					    <versionName>${version.name}</versionName>
					    
					    <providedKeyStorePath>${android.keystore.path}</providedKeyStorePath>
					    <providedKeyStorePassword>${android.keystore.password}</providedKeyStorePassword>
					    <providedKeyAlias>${android.keyalias}</providedKeyAlias>
					    <providedKeyAliasPassword>${android.keyalias.password}</providedKeyAliasPassword>

					</releaseConfiguration>

                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <repositories>
	    <repository>
	        <id>gluon-releases</id>
	        <url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url>
	    </repository>
	</repositories>


    <!-- Perfil rápido para Android: mvn -Pandroid gluonfx:build -->
    <profiles>
		<profile>
		    <id>android</id>
		    <properties>
		        <gluonfx.target>android</gluonfx.target>
		    </properties>
		    <build>
		        <plugins>
		            <plugin>
		                <groupId>com.gluonhq</groupId>
		                <artifactId>gluonfx-maven-plugin</artifactId>
		                <configuration>
		                    <linkerArgs>
		                        <arg>-fPIC</arg>
		                    </linkerArgs>
		                </configuration>
		            </plugin>
		        </plugins>
		    </build>
		</profile>

        <profile>
          <id>ios</id>
          <properties>
            <gluonfx.target>ios</gluonfx.target>
          </properties>
        </profile>
    </profiles>
    
    
</project>